{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": [
    "target",
    "node_modules",
    "scripts",
    "triples/index.js",
    ".yarn",
    "yarn.lock",
    "CHANGELOG.md",
    "**/*.toml",
    "**/__snapshots__/**",
    "**/*.snap",
    "examples/napi/index.cjs",
    "examples/napi/index.d.cts",
    "examples/napi/index.d.ts",
    "examples/napi/example.wasi.cjs",
    "examples/napi/example.wasi.d.cts",
    "examples/napi/example.wasi-browser.js",
    "examples/napi/example.wasip1.cjs",
    "examples/napi/example.wasip1.d.cts",
    "examples/napi/example.wasip1-browser.js",
    "examples/napi/example.wasip1-deferred.js",
    "examples/napi/example.wasip1-deferred.d.ts",
    "examples/napi/wasi-worker.mjs",
    "examples/napi/wasi-worker-browser.mjs",
    "examples/napi-compat-mode/index.wasi.cjs",
    ".script-jail.lock.yml"
  ]
}
